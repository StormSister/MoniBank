//MBACMAP JOB (TEST),'BUILD MBAC MAP',
//             CLASS=A,
//             MSGCLASS=A,
//             MSGLEVEL=(1,1),
//             USER=${JOB_USER},
//             PASSWORD=${JOB_PASSWORD}
//JOBPROC  DD DSN=HERC01.KICKSSYS.V1R5M0.PROCLIB,DISP=SHR
//MAP      EXEC KIKMAPS,MAPNAME=MBACMSD
//COPY.SYSUT1 DD *
MBACMSD KIKMSD MODE=INOUT,CTRL=(FREEKB,FRSET)
MBACMAP KIKMDI SIZE=(24,80)
         KIKMDF POS=(1,29),LENGTH=12,INITIAL='ADD CUSTOMER'
         KIKMDF POS=(3,5),LENGTH=11,INITIAL='REQUEST ID:'
REQID    KIKMDF POS=(3,22),LENGTH=8,ATTRB=(UNPROT,IC,FSET)
         KIKMDF POS=(4,5),LENGTH=8,INITIAL='COUNTRY:'
CNTRY    KIKMDF POS=(4,22),LENGTH=2,ATTRB=(UNPROT,FSET)
         KIKMDF POS=(5,5),LENGTH=12,INITIAL='NATIONAL ID:'
NATID    KIKMDF POS=(5,22),LENGTH=11,ATTRB=(UNPROT,FSET)
         KIKMDF POS=(6,5),LENGTH=11,INITIAL='FIRST NAME:'
FNAME    KIKMDF POS=(6,22),LENGTH=30,ATTRB=(UNPROT,FSET)
         KIKMDF POS=(7,5),LENGTH=10,INITIAL='LAST NAME:'
LNAME    KIKMDF POS=(7,22),LENGTH=40,ATTRB=(UNPROT,FSET)
         KIKMDF POS=(8,5),LENGTH=14,INITIAL='DATE OF BIRTH:'
DOB      KIKMDF POS=(8,22),LENGTH=8,ATTRB=(UNPROT,FSET)
         KIKMDF POS=(9,5),LENGTH=11,INITIAL='CREATED AT:'
CRTDAT   KIKMDF POS=(9,22),LENGTH=14,ATTRB=(UNPROT,FSET)
         KIKMDF POS=(11,5),LENGTH=12,INITIAL='CNTL=CREATE'
MSGTXT   KIKMDF POS=(13,5),LENGTH=70
         KIKMSD TYPE=FINAL
         END
/*
//