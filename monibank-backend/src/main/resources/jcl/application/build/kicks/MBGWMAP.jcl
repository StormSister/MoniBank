//MBGWMAP JOB (TEST),'BUILD JAVA GATEWAY',
//             CLASS=A,
//             MSGCLASS=A,
//             MSGLEVEL=(1,1),
//             USER=${JOB_USER},
//             PASSWORD=${JOB_PASSWORD}
//JOBPROC  DD DSN=HERC01.KICKSSYS.V1R5M0.PROCLIB,DISP=SHR
//MAP      EXEC KIKMAPS,MAPNAME=MBGWMSD
//COPY.SYSUT1 DD *
MBGWMSD KIKMSD MODE=INOUT,CTRL=(FREEKB,FRSET)
MBGWMAP KIKMDI SIZE=(24,80)
         KIKMDF POS=(1,25),LENGTH=12,INITIAL='MONIBANK API'
         KIKMDF POS=(2,5),LENGTH=11,INITIAL='PROTOCOL 01'
         KIKMDF POS=(4,5),LENGTH=10,INITIAL='OPERATION:'
OPER     KIKMDF POS=(4,22),LENGTH=8,ATTRB=(UNPROT,IC,FSET)
         KIKMDF POS=(5,5),LENGTH=11,INITIAL='REQUEST ID:'
REQID    KIKMDF POS=(5,22),LENGTH=8,ATTRB=(UNPROT,FSET)
         KIKMDF POS=(6,5),LENGTH=13,INITIAL='INPUT LENGTH:'
INLEN    KIKMDF POS=(6,22),LENGTH=4,ATTRB=(UNPROT,FSET)
         KIKMDF POS=(7,5),LENGTH=14,INITIAL='INPUT: MAX 512'
IN01     KIKMDF POS=(8,5),LENGTH=64,ATTRB=(UNPROT,FSET)
IN02     KIKMDF POS=(9,5),LENGTH=64,ATTRB=(UNPROT,FSET)
IN03     KIKMDF POS=(10,5),LENGTH=64,ATTRB=(UNPROT,FSET)
IN04     KIKMDF POS=(11,5),LENGTH=64,ATTRB=(UNPROT,FSET)
IN05     KIKMDF POS=(12,5),LENGTH=64,ATTRB=(UNPROT,FSET)
IN06     KIKMDF POS=(13,5),LENGTH=64,ATTRB=(UNPROT,FSET)
IN07     KIKMDF POS=(14,5),LENGTH=64,ATTRB=(UNPROT,FSET)
IN08     KIKMDF POS=(15,5),LENGTH=64,ATTRB=(UNPROT,FSET)
         KIKMDF POS=(18,5),LENGTH=6,INITIAL='STATE:'
STATE    KIKMDF POS=(18,22),LENGTH=8,ATTRB=(PROT)
         KIKMDF POS=(19,5),LENGTH=11,INITIAL='RESULT FOR:'
ACKID    KIKMDF POS=(19,22),LENGTH=8,ATTRB=(PROT)
MSGTXT   KIKMDF POS=(21,5),LENGTH=70,ATTRB=(PROT)
         KIKMDF POS=(23,5),LENGTH=13,INITIAL='ENTER=EXECUTE'
         KIKMSD TYPE=FINAL
         END
/*
