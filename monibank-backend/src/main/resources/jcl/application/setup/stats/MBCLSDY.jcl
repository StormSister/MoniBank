//${REQUEST_ID} JOB (TEST),'CLOSE ${BUSINESS_DATE}',
//             CLASS=A,
//             MSGCLASS=A,
//             MSGLEVEL=(1,1),
//             USER=${JOB_USER},
//             PASSWORD=${JOB_PASSWORD}
//*
//* READ-ONLY EXTRACT MAY RUN WHILE KICKS IS ACTIVE.
//* MEMBER NAME IS D + YYMMDD. A RERUN REPLACES THE SAME DAY.
//* CHECK WRITES THE VALID REPORT TO THE JAVA PRINTER (CLASS Z).
//*
//EXTRACT  EXEC PGM=IDCAMS
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//CUSTIN   DD DSN=&&CUSTIN,
//            DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(TRK,(5,2),RLSE),
//            DCB=(DSORG=PS,RECFM=F,LRECL=119,BLKSIZE=119)
//TXNIN    DD DSN=&&TXNIN,
//            DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(TRK,(10,5),RLSE),
//            DCB=(DSORG=PS,RECFM=F,LRECL=119,BLKSIZE=119)
//SYSIN    DD *
  REPRO INDATASET(MBANK.CUST) OUTFILE(CUSTIN)
  REPRO INDATASET(MBANK.TXN) OUTFILE(TXNIN)
/*
//*
//DAILY    EXEC PGM=MBDAILY,COND=(0,NE,EXTRACT)
//STEPLIB  DD DSN=HERC01.TEST.LOADLIB,DISP=SHR
//CUSTIN   DD DSN=&&CUSTIN,DISP=(OLD,DELETE)
//TXNIN    DD DSN=&&TXNIN,DISP=(OLD,DELETE)
//REPORT   DD DSN=HERC01.MBANK.REPORTS(${REPORT_MEMBER}),DISP=OLD
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//CTLIN    DD *
${BUSINESS_DATE}${CURRENCY}
/*
//*
//CHECK    EXEC PGM=IEBGENER,COND=(0,NE,DAILY)
//SYSPRINT DD SYSOUT=A
//SYSUT1   DD DSN=HERC01.MBANK.REPORTS(${REPORT_MEMBER}),DISP=SHR
//SYSUT2   DD SYSOUT=Z
//SYSIN    DD DUMMY
