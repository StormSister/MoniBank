//TXNSEED JOB (TEST),'SEED TXN VSAM',
//             CLASS=A,
//             MSGCLASS=A,
//             MSGLEVEL=(1,1),
//             USER=${JOB_USER},
//             PASSWORD=${JOB_PASSWORD}
//*
//MAKE     EXEC PGM=SEEDTXN
//STEPLIB  DD DSN=HERC01.TEST.LOADLIB,DISP=SHR
//OUTPUT   DD DSN=&&SEEDIN,
//             DISP=(NEW,PASS,DELETE),
//             UNIT=SYSDA,
//             SPACE=(TRK,(1,1)),
//             DCB=(DSORG=PS,RECFM=FB,LRECL=119,BLKSIZE=1190)
//SYSOUT   DD SYSOUT=*
//*
//LOAD     EXEC PGM=IDCAMS,COND=(0,NE,MAKE)
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//INDD     DD DSN=&&SEEDIN,DISP=(OLD,DELETE)
//OUTDD    DD DSN=MBANK.TXN,DISP=SHR
//SYSIN    DD *
  REPRO INFILE(INDD) OUTFILE(OUTDD)
/*
//*
//CHECK    EXEC PGM=IDCAMS,COND=(0,NE,LOAD)
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENT(MBANK.TXN) ALL
  PRINT INDATASET(MBANK.TXN) DUMP
/*