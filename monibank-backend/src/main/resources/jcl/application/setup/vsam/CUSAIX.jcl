//CUSAIX   JOB (TEST),'BUILD CUSTOMER AIX',
//             CLASS=A,
//             MSGCLASS=A,
//             MSGLEVEL=(1,1),
//             USER=${JOB_USER},
//             PASSWORD=${JOB_PASSWORD}
//*
//DEFAIX   EXEC PGM=IDCAMS
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE ALTERNATEINDEX ( -
         NAME(MBANK.CUST.NATIX) -
         RELATE(MBANK.CUST) -
         VOLUMES(TSO001) -
         TRACKS(1 1) -
         KEYS(13 14) -
         RECORDSIZE(31 31) -
         UNIQUEKEY -
         UPGRADE -
  ) -
  DATA ( -
       NAME(MBANK.CUST.NATIX.D) -
  ) -
  INDEX ( -
        NAME(MBANK.CUST.NATIX.I) -
  )
/*
//*
//BUILD    EXEC PGM=IDCAMS,COND=(0,NE,DEFAIX)
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  BLDINDEX -
       INDATASET(MBANK.CUST) -
       OUTDATASET(MBANK.CUST.NATIX)
/*
//*
//DEFPATH  EXEC PGM=IDCAMS,COND=(0,NE,BUILD)
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE PATH ( -
         NAME(MBANK.CUST.NATPATH) -
         PATHENTRY(MBANK.CUST.NATIX) -
         UPDATE -
  )
/*
//*
//CHECK    EXEC PGM=IDCAMS,COND=(0,NE,DEFPATH)
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENT(MBANK.CUST.NATIX) ALL
  LISTCAT ENT(MBANK.CUST.NATPATH) ALL
  PRINT INDATASET(MBANK.CUST.NATPATH) CHARACTER
/*