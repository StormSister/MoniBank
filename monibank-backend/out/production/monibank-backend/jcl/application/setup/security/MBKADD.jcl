//ADDUSER EXEC PGM=IKJEFT01
//SYSUADS  DD DISP=SHR,DSN=SYS1.UADS
//SYSLBC   DD DISP=SHR,DSN=SYS1.BRODCAST
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
 ACCOUNT
 ADD (MBKSRV * * ISPLOGON) +
     NOLIM +
     NOOPER +
     NOACCT +
     JCL +
     NOMOUNT +
     UNIT(TSO) +
     SIZE(8192)
 LIST (MBKSRV)
 END
