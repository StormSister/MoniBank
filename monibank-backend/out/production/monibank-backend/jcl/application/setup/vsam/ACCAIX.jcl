//ACCAIX  JOB (TEST),'BUILD ACCOUNT AIX',
//             CLASS=A,
//             MSGCLASS=A,
//             MSGLEVEL=(1,1),
//             USER=${JOB_USER},
//             PASSWORD=${JOB_PASSWORD}
//*
//DEFCUST  EXEC PGM=IDCAMS
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE ALTERNATEINDEX ( -
         NAME(MBANK.ACCT.CUSTIX) -
         RELATE(MBANK.ACCT) -
         VOLUMES(TSO001) -
         TRACKS(1 1) -
         KEYS(13 14) -
         RECORDSIZE(31 1318) -
         NONUNIQUEKEY -
         UPGRADE -
  ) -
  DATA ( -
       NAME(MBANK.ACCT.CUSTIX.D) -
  ) -
  INDEX ( -
        NAME(MBANK.ACCT.CUSTIX.I) -
  )
/*
//*
//BLDCUST  EXEC PGM=IDCAMS,COND=(0,NE,DEFCUST)
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  BLDINDEX -
       INDATASET(MBANK.ACCT) -
       OUTDATASET(MBANK.ACCT.CUSTIX)
/*
//*
//PTHCUST  EXEC PGM=IDCAMS,COND=(0,NE,BLDCUST)
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE PATH ( -
         NAME(MBANK.ACCT.CUSTPATH) -
         PATHENTRY(MBANK.ACCT.CUSTIX) -
         UPDATE -
  )
/*
//*
//DEFIBAN  EXEC PGM=IDCAMS,COND=(0,NE,PTHCUST)
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE ALTERNATEINDEX ( -
         NAME(MBANK.ACCT.IBANIX) -
         RELATE(MBANK.ACCT) -
         VOLUMES(TSO001) -
         TRACKS(1 1) -
         KEYS(34 27) -
         RECORDSIZE(52 52) -
         UNIQUEKEY -
         UPGRADE -
  ) -
  DATA ( -
       NAME(MBANK.ACCT.IBANIX.D) -
  ) -
  INDEX ( -
        NAME(MBANK.ACCT.IBANIX.I) -
  )
/*
//*
//BLDIBAN  EXEC PGM=IDCAMS,COND=(0,NE,DEFIBAN)
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  BLDINDEX -
       INDATASET(MBANK.ACCT) -
       OUTDATASET(MBANK.ACCT.IBANIX)
/*
//*
//PTHIBAN  EXEC PGM=IDCAMS,COND=(0,NE,BLDIBAN)
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE PATH ( -
         NAME(MBANK.ACCT.IBANPATH) -
         PATHENTRY(MBANK.ACCT.IBANIX) -
         UPDATE -
  )
/*
//*
//CHECK    EXEC PGM=IDCAMS,COND=(0,NE,PTHIBAN)
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENT(MBANK.ACCT.CUSTIX) ALL
  LISTCAT ENT(MBANK.ACCT.CUSTPATH) ALL
  LISTCAT ENT(MBANK.ACCT.IBANIX) ALL
  LISTCAT ENT(MBANK.ACCT.IBANPATH) ALL
  PRINT INDATASET(MBANK.ACCT.CUSTPATH) DUMP
  PRINT INDATASET(MBANK.ACCT.IBANPATH) DUMP
/*
