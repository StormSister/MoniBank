//CARDVSAM JOB (TEST),'CREATE CARD VSAM',
//             CLASS=A,
//             MSGCLASS=A,
//             MSGLEVEL=(1,1),
//             USER=${JOB_USER},
//             PASSWORD=${JOB_PASSWORD}
//*
//DEFINE   EXEC PGM=IDCAMS
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE CLUSTER ( -
         NAME(MBANK.CARD) -
         VOLUMES(TSO001) -
         INDEXED -
         KEYS(13 1) -
         RECORDSIZE(119 119) -
         TRACKS(5 2) -
         SHAREOPTIONS(2 3) -
  ) -
  DATA ( -
       NAME(MBANK.CARD.D) -
  ) -
  INDEX ( -
        NAME(MBANK.CARD.I) -
  )
/*
//*
//CHECK    EXEC PGM=IDCAMS,COND=(0,NE,DEFINE)
//STEPCAT  DD DSN=SYS1.UCAT.TSO,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENT(MBANK.CARD) ALL
/*

