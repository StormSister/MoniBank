# -------------------------------------------------------------------
# Spring profile
# -------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

# -------------------------------------------------------------------
# Administrator API — required
# -------------------------------------------------------------------
MONIBANK_ADMIN_USERNAME=
MONIBANK_ADMIN_PASSWORD=
MONIBANK_JWT_SECRET=

# Optional; ISO-8601 duration
MONIBANK_ADMIN_TOKEN_TTL=PT1H

# -------------------------------------------------------------------
# Mainframe credentials — required
# -------------------------------------------------------------------
MAINFRAME_JOB_USER=HERC01
MAINFRAME_JOB_PASSWORD=

MB_TSO_USERNAME_1=MBKSRV1
MB_TSO_PASSWORD_1=

MB_TSO_USERNAME_2=MBKSRV2
MB_TSO_PASSWORD_2=

# Optional third terminal
MB_TSO_USERNAME_3=MBKSRV3
MB_TSO_PASSWORD_3=

# -------------------------------------------------------------------
# Terminal pool
# -------------------------------------------------------------------
MB_TERMINAL_ENABLED=true
MB_TERMINAL_POOL_SIZE=2
MB_TERMINAL_RECOVERY_DELAY=2s

# -------------------------------------------------------------------
# Operation journal
# -------------------------------------------------------------------
MONIBANK_OPERATION_JOURNAL_DIR=logs/operations
MONIBANK_OPERATION_RETENTION_DAYS=30

# -------------------------------------------------------------------
# Daily close
# -------------------------------------------------------------------
MB_DAILY_CLOSE_ENABLED=false
MB_DAILY_CLOSE_CATCH_UP=false
MB_DAILY_CLOSE_CRON=0 5 0 * * *
MB_DAILY_CLOSE_ZONE=Europe/Warsaw
MB_DAILY_CLOSE_CURRENCY=EUR
MB_INTEREST_RATE_BPS=500

# -------------------------------------------------------------------
# Rate limiting
# -------------------------------------------------------------------
MONIBANK_RATE_LIMIT_ENABLED=true
MONIBANK_TRUSTED_CLIENT_IP_HEADER=
MONIBANK_RATE_LIMIT_MAX_CLIENTS=10000
MONIBANK_RATE_LIMIT_IDLE_TTL=PT2H
MONIBANK_RATE_LIMIT_CLEANUP_INTERVAL=PT5M

MONIBANK_AUTH_LIMIT_CAPACITY=5
MONIBANK_AUTH_LIMIT_REFILL_TOKENS=5
MONIBANK_AUTH_LIMIT_REFILL_PERIOD=PT15M

MONIBANK_READ_LIMIT_CAPACITY=240
MONIBANK_READ_LIMIT_REFILL_TOKENS=240
MONIBANK_READ_LIMIT_REFILL_PERIOD=PT1M

MONIBANK_WRITE_LIMIT_CAPACITY=12
MONIBANK_WRITE_LIMIT_REFILL_TOKENS=12
MONIBANK_WRITE_LIMIT_REFILL_PERIOD=PT1H

# -------------------------------------------------------------------
# Optional log and monitoring configuration
# Final production values will be confirmed during deployment.
# -------------------------------------------------------------------
MAINFRAME_LOG_HOST=
MAINFRAME_LOG_USER=root
MAINFRAME_LOG_PATH=
MAINFRAME_LIVE_LOG_CONTAINER=monibank-mainframe
MAINFRAME_LIVE_LOG_PATH=/opt/mvs-tk5/log/hardcopy.log
MAINFRAME_METRICS_REFRESH_MS=15000