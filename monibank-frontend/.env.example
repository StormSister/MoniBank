# Leave empty in local development: Vite proxies /api to Spring on port 8080.
VITE_API_BASE_URL=
# Production defaults to /blog on the same host. Set the VitePress dev URL locally.
# VITE_DOCUMENTATION_BASE_URL=http://localhost:5174/blog
# Optional: pin a closed business day while developing.
# VITE_DAILY_CLOSE_DATE=2026-09-07
